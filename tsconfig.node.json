{
  "extends": "@lark-apaas/fullstack-presets/lib/simple/tsconfig/tsconfig.node.json",
  "compilerOptions": {
    "baseUrl": "./",
    "outDir": "./dist",
    "resolveJsonModule": true,
    "paths": {
      "@server/*": ["server/*"],
      "@shared/*": ["shared/*"]
    }
  },
  "watchOptions": {
    "excludeDirectories": ["node_modules/**"]
  },
  "include": ["server/**/*", "shared/*", "shared/*.json"],
  "exclude": [
    "node_modules",
    "dist",
    "client",
    "server/modules/hello/**/*",
    "**/*.spec.ts",
    "**/*.e2e-spec.ts"
  ]
}
