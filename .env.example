SERVER_PORT=3001
SERVER_HOST=0.0.0.0
# Optional startup readiness window for cold Windows deployments (60-1800 seconds; default 300).
APP_STARTUP_TIMEOUT_SECONDS=300
FORCE_AUTHN_INNERAPI_DOMAIN=
# Public browser URL. For HTTPS public deployment, use the hostname covered by the certificate.
PUBLIC_BASE_URL=
# Optional browser base path, for example /nantong. Leave empty for root deployment.
CLIENT_BASE_PATH=
# URL opened by start.cmd on the local server/browser. Leave empty to use SERVER_HOST/SERVER_PORT.
BROWSER_OPEN_URL=
# Client runtime parent origin for the Feishu webpage plugin. Override only for a different trusted parent origin.
FORCE_FRAMEWORK_DOMAIN_MAIN=https://vnet.feishu.cn
SUDA_DATABASE_URL=
# Standalone mode automatically enables this when SUDA_DATABASE_URL is empty; NODE_ENV remains production.
FORCE_FRAMEWORK_DISABLE_DATAPASS=
CLIENT_DEV_PORT=8888
LOG_REQUEST_BODY=false
LOG_RESPONSE_BODY=false

# Optional direct HTTPS. The certificate must cover PUBLIC_BASE_URL, especially for Feishu iframe embedding.
HTTPS_CERT_PATH=
HTTPS_KEY_PATH=
HTTPS_CA_PATH=
# start.ps1 readiness checks allow self-signed certificates by default.
HTTPS_ALLOW_SELF_SIGNED=true

# Feishu open platform app credentials
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# Optional dedicated HMAC key for short-lived screenshot access tokens.
# Production requires this value or FEISHU_APP_SECRET/APP_SECRET.
MONTHLY_SCHEDULE_SCREENSHOT_ACCESS_SECRET=
# Risk inspection dashboards. Use a dedicated app when the general app cannot
# read these two Base documents. Credentials can also come from the monthly-report config.
FEISHU_RISK_INSPECTION_APP_ID=
FEISHU_RISK_INSPECTION_APP_SECRET=
FEISHU_RISK_INSPECTION_CREDENTIALS_CONFIG=
FEISHU_RISK_INSPECTION_ALI_SOURCE_URL=https://example.feishu.cn/wiki/PUBLIC_EXAMPLE_SOURCE
FEISHU_RISK_INSPECTION_CROSS_SOURCE_URL=https://example.feishu.cn/base/PUBLIC_EXAMPLE_SOURCE
# Optional Feishu OAuth role allowlists. Comma-separate multiple Open IDs; keep real identities in the ignored .env only.
FEISHU_ACCESS_ADMIN_OPEN_IDS=
FEISHU_ACCESS_EDITOR_OPEN_IDS=
FEISHU_ACCESS_PURCHASE_ADMIN_OPEN_IDS=
# Approved application-bound identity fingerprints are bundled without raw Open IDs.
# Set false to disable these approved grants and use only environment allowlists.
FEISHU_ACCESS_APPROVED_GRANTS_ENABLED=true
FEISHU_ACCESS_BUILDING_ADMIN_A_OPEN_IDS=
FEISHU_ACCESS_BUILDING_ADMIN_B_OPEN_IDS=
FEISHU_ACCESS_BUILDING_ADMIN_C_OPEN_IDS=
FEISHU_ACCESS_BUILDING_ADMIN_D_OPEN_IDS=
FEISHU_ACCESS_BUILDING_ADMIN_E_OPEN_IDS=
FEISHU_ACCESS_BUILDING_ADMIN_H_OPEN_IDS=
FEISHU_ACCESS_BUILDING_ADMIN_110_OPEN_IDS=
FEISHU_ACCESS_INVENTORY_ADMIN_A_OPEN_IDS=
FEISHU_ACCESS_INVENTORY_ADMIN_B_OPEN_IDS=
FEISHU_ACCESS_INVENTORY_ADMIN_C_OPEN_IDS=
FEISHU_ACCESS_INVENTORY_ADMIN_D_OPEN_IDS=
FEISHU_ACCESS_INVENTORY_ADMIN_E_OPEN_IDS=
FEISHU_ACCESS_INVENTORY_ADMIN_H_OPEN_IDS=
FEISHU_ACCESS_DUTY_EDITOR_OPEN_IDS=
FEISHU_ACCESS_SUPPLY_CHAIN_ADMIN_OPEN_IDS=
FEISHU_ACCESS_CONSTRUCTION_ADMIN_OPEN_IDS=
# Comma-separated Open IDs. While contract notifications are under verification,
# route them to a designated test receiver instead of the dynamic manager/owner list.
FEISHU_CONTRACT_NOTIFICATION_RECEIVER_OPEN_IDS=

# Ali monthly report generation and four-file bundle.
# For server deployment, prefer these variables over local config.json paths.
ALI_MONTHLY_REPORT_CONFIG=
ALI_MONTHLY_REPORT_OUTPUT_DIR=output/ali-monthly-report
ALI_MONTHLY_REPORT_OUTPUT_LABEL=output/ali-monthly-report
# Required for Feishu download notifications; use the externally reachable HTTPS app base URL.
ALI_MONTHLY_REPORT_PUBLIC_BASE_URL=
# Manual upload result cards are sent to every chat ID in this list.
ALI_MONTHLY_REPORT_FEISHU_CHAT_IDS=oc_336214cd13682bea8343b0d6b03f1735,oc_bde03118a6c8a542c66286ad9058ed6b
# Legacy single-chat fallback retained for older deployments.
ALI_MONTHLY_REPORT_FEISHU_CHAT_ID=oc_336214cd13682bea8343b0d6b03f1735
# The four-item ZIP is also sent directly to this Feishu user. Prefer open_id;
# when it is blank, the service sends by the configured Feishu email instead.
ALI_MONTHLY_REPORT_FEISHU_MA_JINYU_OPEN_ID=
ALI_MONTHLY_REPORT_FEISHU_MA_JINYU_EMAIL=user-b54e355d@example.com
# Monthly automation sends one three-item summary card only to this chat.
ALI_MONTHLY_REPORT_AUTOMATION_CHAT_ID=oc_bde03118a6c8a542c66286ad9058ed6b
# Enabled by default. Set false to stop startup catch-up and monthly scheduling.
ALI_MONTHLY_REPORT_SCHEDULER_ENABLED=true
# Optional absolute path. Production defaults to ../nantong-schedule-state/ali-monthly-report-task-state.json.
ALI_MONTHLY_REPORT_AUTOMATION_STATE_PATH=
ALI_MONTHLY_REPORT_FEISHU_APP_ID=
ALI_MONTHLY_REPORT_FEISHU_APP_SECRET=
# Optional dedicated secret for 72-hour Ali monthly report Feishu download links; use at least 32 random bytes.
# If empty, a purpose-isolated key is derived from ALI_MONTHLY_REPORT_FEISHU_APP_SECRET / FEISHU_APP_SECRET.
ALI_MONTHLY_REPORT_DOWNLOAD_SIGNING_SECRET=
# Optional. When empty, parsed from HIGH_POWER_SOURCE_URL / ALI_ALARM_ATTACHMENT_SOURCE_URL.
ALI_MONTHLY_REPORT_FEISHU_APP_TOKEN=
ALI_POWER_ALERT_CONFIG_PATH=
ALI_MONTHLY_REPORT_PYTHON=
ALI_MONTHLY_REPORT_EMAIL_APP_DIR=tools/ali-monthly-report-email
