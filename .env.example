ATTENDANCE_AUTOMATION_RETRY_MAX_ATTEMPTS=6
ATTENDANCE_AUTOMATION_RETRY_WINDOW_MINUTES=30
# 人员目录跨进程缓存 24 小时，避免每个考勤时点重复遍历部门和人员。
