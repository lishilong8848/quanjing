OVERTIME_WORKFLOW_PROGRAM_ENABLED=true
# 推荐显式档位：生产服务器用 production；本地常规开发用 disabled；独立测试应用联调用 local-test。
# 留空时兼容旧逻辑：正式热包自动开启，源码/开发运行默认关闭。
FEISHU_CARD_ACTION_CONSUMER_PROFILE=
# local-test 必填，且测试 App ID 必须与上方生产 FEISHU_APP_ID 不同；禁止填写生产应用凭据。
FEISHU_CARD_ACTION_TEST_APP_ID=
FEISHU_CARD_ACTION_TEST_APP_SECRET=
# 旧版兼容开关；已配置 PROFILE 时由 PROFILE 优先决定是否启用。
FEISHU_CARD_ACTION_CONSUMER_ENABLED=
# 开启加班工作流时，服务会使用 FEISHU_APP_ID / FEISHU_APP_SECRET
# 自动建立卡片回调长连接。飞书开放平台需选择“使用长连接接收回调”，
# 并订阅 card.action.trigger。不要启动多个使用同一本地台账的实例。
# 启动脚本留空时自动使用发布目录外的共享状态路径；直接运行 Node 时使用 data/overtime-workflow/ledger.json。
OVERTIME_WORKFLOW_LEDGER_PATH=
OVERTIME_WORKFLOW_TASK_POLL_INTERVAL_MS=5000
# 程序托管的请休假卡片审批。默认关闭；启用前必须完成字段迁移。
LEAVE_WORKFLOW_PROGRAM_ENABLED=true
LEAVE_WORKFLOW_STARTUP_RECOVERY_CODES=
LEAVE_WORKFLOW_LEDGER_PATH=
LEAVE_WORKFLOW_TASK_POLL_INTERVAL_MS=5000
