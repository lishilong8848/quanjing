# Interactive purchase workflow. Keep this section free of real identities and secrets.
# The packaged launcher validates the full purchase-card configuration and injects
# both workflow flags into the candidate process automatically. When the dedicated
# manager open_id is absent, startup may atomically persist only that value after a
# unique active-manager match in the configured organization Base; all other dotenv
# values remain unchanged and validation completes before any service replacement.
# Emergency opt-out: set this to false and keep both flags below false.
PURCHASE_WORKFLOW_AUTO_ENABLE_ON_START=true
# These persisted values remain false as a rollback-safe baseline. Do not enable
# them manually for a normal deployment; deploy/start.ps1 supplies process values.
PURCHASE_WORKFLOW_PROGRAM_ENABLED=false
PURCHASE_WORKFLOW_APPROVER_OPEN_IDS=
PURCHASE_WORKFLOW_PURCHASE_ADMIN_OPEN_ID=
PURCHASE_WORKFLOW_LEDGER_PATH=.runtime/purchase-workflow-ledger.json
# Optional; blank uses the runtime default of 5000 ms.
PURCHASE_WORKFLOW_TASK_POLL_INTERVAL_MS=5000
# Version 3 purchase manager batch card. Before production business validation,
# disable only the duplicate Base manager-approval automation to avoid double send.
# New submissions create one card per application batch; existing Version 2
# single-record cards remain valid during the controlled cutover.
PURCHASE_MANAGER_APPROVAL_CARD_ENABLED=false
# Optional when PURCHASE_MANAGER_APPROVER_NAME uniquely identifies one active
# manager in the configured organization Base; startup resolves and persists it.
PURCHASE_MANAGER_APPROVER_OPEN_ID=
PURCHASE_MANAGER_APPROVER_NAME=示例人员020
FEISHU_PURCHASE_CARD_VERIFICATION_TOKEN=
# Optional. When configured, use the Encrypt Key from the Feishu card callback settings.
FEISHU_PURCHASE_CARD_ENCRYPT_KEY=
# Warehouse-manager Base: dedicated source fields are optional. When all are blank,
# startup reuses FEISHU_WAREHOUSE_SOURCE_URL / FEISHU_WAREHOUSE_APP_TOKEN above.
# FEISHU_WAREHOUSE_MANAGER_TABLE_ID is still required.
FEISHU_WAREHOUSE_MANAGER_SOURCE_URL=
FEISHU_WAREHOUSE_MANAGER_APP_TOKEN=
FEISHU_WAREHOUSE_MANAGER_WIKI_TOKEN=
FEISHU_WAREHOUSE_MANAGER_TABLE_ID=
FEISHU_WAREHOUSE_MANAGER_VIEW_ID=
# Required for delegated-app purchase workflow actions.
# Use real organization open_id values; local role validation still applies.
PURCHASE_WORKFLOW_ADMIN_OPERATOR_OPEN_ID=
PURCHASE_WORKFLOW_EDITOR_OPERATOR_OPEN_ID=
# PUBLIC_BASE_URL above is also required for inventory deep links.
# End interactive purchase workflow.
FEISHU_PURCHASE_ORGANIZATION_TABLE_ID=PUBLIC_EXAMPLE_FEISHU_PURCHASE_ORGANIZATION_TABLE_ID

