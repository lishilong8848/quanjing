{
  "name": "fullstack-nestjs-template",
  "version": "2.1.7",
  "private": true,
  "flags": {
    "supportBusinessUser": true,
    "supportTiptapAndStreamdown": true
  },
  "scripts": {
    "dev": "concurrently -n \"server,client\" -c \"blue,green\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "cross-env NODE_ENV=development node scripts/run-with-env.mjs nest start --watch",
    "dev:client": "cross-env NODE_ENV=development node scripts/run-with-env.mjs rspack serve --config rspack.config.js --env mode=development",
    "gen:db-schema": "fullstack-cli gen-db-schema",
    "gen:openapi": "echo 'UNSUPPORTED, SKIP'",
    "build": "npm run build:prod",
    "build:prod": "npm run build:server && npm run build:client",
    "build:server": "cross-env NODE_ENV=production nest build",
    "build:client": "cross-env NODE_ENV=production rspack build --config rspack.config.js --env mode=production && cross-env NODE_ENV=production rspack build --config rspack.overtime-confirmation.config.js --env mode=production",
    "package:migration": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/create-migration-package.ps1",
    "start": "cross-env NODE_ENV=production node dist/server/main.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:e2e": "jest --config test/e2e/jest.config.js",
    "self-test:contract-creation": "npm run build:server && node scripts/run-with-env.mjs node scripts/self-test-contract-creation.mjs",
    "self-test:contract-lifecycle": "npm run build:server && node scripts/run-with-env.mjs node scripts/self-test-contract-lifecycle.mjs",
    "self-test:overtime-request": "npm run build:server && node scripts/run-with-env.mjs node scripts/self-test-overtime-request.mjs",
    "self-test:employee-onboarding": "npm run build:server && node scripts/run-with-env.mjs node scripts/self-test-employee-onboarding.mjs run",
    "self-test:employee-onboarding:cleanup": "npm run build:server && node scripts/run-with-env.mjs node scripts/self-test-employee-onboarding.mjs cleanup-only",
    "self-test:overtime-workflow:dry-run": "node scripts/run-with-env.mjs node scripts/self-test-overtime-workflow.mjs --dry-run",
    "self-test:overtime-workflow:apply-real": "npm run build:server && node scripts/run-with-env.mjs node scripts/self-test-overtime-workflow.mjs --apply-real",
    "self-test:overtime-workflow:audit": "npm run build:server && node scripts/run-with-env.mjs node scripts/self-test-overtime-workflow.mjs --audit-only",
    "self-test:overtime-workflow:cleanup": "npm run build:server && node scripts/run-with-env.mjs node scripts/self-test-overtime-workflow.mjs --cleanup-only",
    "migrate:overtime-workflow-fields:dry-run": "node scripts/run-with-env.mjs node scripts/ensure-overtime-workflow-fields.mjs --dry-run",
    "migrate:overtime-workflow-fields:check": "node scripts/run-with-env.mjs node scripts/ensure-overtime-workflow-fields.mjs --dry-run --require-ready",
    "migrate:overtime-workflow-fields": "node scripts/run-with-env.mjs node scripts/ensure-overtime-workflow-fields.mjs --apply",
    "migrate:leave-workflow-fields:dry-run": "node scripts/run-with-env.mjs node scripts/ensure-leave-workflow-fields.mjs",
    "migrate:leave-workflow-fields:check": "node scripts/run-with-env.mjs node scripts/ensure-leave-workflow-fields.mjs --require-ready",
    "migrate:leave-workflow-fields": "node scripts/run-with-env.mjs node scripts/ensure-leave-workflow-fields.mjs --apply",
    "migrate:inventory-outbound-approval-fields:dry-run": "node scripts/run-with-env.mjs node scripts/ensure-inventory-outbound-approval-fields.mjs --dry-run",
    "migrate:inventory-outbound-approval-fields:check": "node scripts/run-with-env.mjs node scripts/ensure-inventory-outbound-approval-fields.mjs --dry-run --require-ready",
    "migrate:inventory-outbound-approval-fields": "node scripts/run-with-env.mjs node scripts/ensure-inventory-outbound-approval-fields.mjs --apply",
    "migrate:leave-shift-details:dry-run": "node scripts/run-with-env.mjs node scripts/ensure-leave-workflow-fields.mjs --with-shift-details",
    "migrate:leave-shift-details:check": "node scripts/run-with-env.mjs node scripts/ensure-leave-workflow-fields.mjs --with-shift-details --require-ready",
    "migrate:leave-shift-details": "node scripts/run-with-env.mjs node scripts/ensure-leave-workflow-fields.mjs --with-shift-details --apply",
    "migrate:leave-shift-details:data:dry-run": "node scripts/run-with-env.mjs node scripts/migrate-leave-shift-substitute-details.mjs --dry-run",
    "migrate:leave-shift-details:data": "node scripts/run-with-env.mjs node scripts/migrate-leave-shift-substitute-details.mjs --apply",
    "migrate:attendance-archive-fields:dry-run": "node scripts/run-with-env.mjs node scripts/ensure-attendance-archive-summary-fields.mjs --dry-run",
    "migrate:attendance-archive-fields:check": "node scripts/run-with-env.mjs node scripts/ensure-attendance-archive-summary-fields.mjs --dry-run --require-ready",
    "migrate:attendance-archive-fields": "node scripts/run-with-env.mjs node scripts/ensure-attendance-archive-summary-fields.mjs --apply",
    "audit:dingtalk-attendance-archive": "node scripts/run-with-env.mjs node scripts/backfill-dingtalk-attendance-archive.mjs --audit-only",
    "backfill:dingtalk-attendance-archive": "node scripts/run-with-env.mjs node scripts/backfill-dingtalk-attendance-archive.mjs",
    "migrate:operations-follow-up-fields:dry-run": "node scripts/run-with-env.mjs node scripts/ensure-today-operations-follow-up-fields.mjs --dry-run",
    "migrate:operations-follow-up-fields:check": "node scripts/run-with-env.mjs node scripts/ensure-today-operations-follow-up-fields.mjs --dry-run --require-ready",
    "migrate:operations-follow-up-fields": "node scripts/run-with-env.mjs node scripts/ensure-today-operations-follow-up-fields.mjs --apply",
    "migrate:legacy-exception-follow-ups:dry-run": "node scripts/run-with-env.mjs node scripts/migrate-legacy-exception-follow-ups.mjs --dry-run",
    "migrate:legacy-exception-follow-ups": "node scripts/run-with-env.mjs node scripts/migrate-legacy-exception-follow-ups.mjs --apply",
    "self-test:leave-workflow": "node scripts/run-with-env.mjs node scripts/self-test-leave-workflow.mjs --dry-run",
    "self-test:leave-workflow:real": "node scripts/run-with-env.mjs node scripts/self-test-leave-workflow.mjs --apply-real",
    "self-test:leave-workflow:audit-cleanup": "node scripts/run-with-env.mjs node scripts/self-test-leave-workflow.mjs --audit-cleanup",
    "migrate:change-adjustment-fields:dry-run": "node scripts/run-with-env.mjs node scripts/ensure-change-adjustment-fields.mjs --dry-run",
    "migrate:change-adjustment-fields": "node scripts/run-with-env.mjs node scripts/ensure-change-adjustment-fields.mjs",
    "migrate:change-drill-report-fields:dry-run": "node scripts/run-with-env.mjs node scripts/ensure-change-drill-report-fields.mjs --dry-run",
    "migrate:change-drill-report-fields": "node scripts/run-with-env.mjs node scripts/ensure-change-drill-report-fields.mjs --apply",
    "migrate:change-summary-report-fields:dry-run": "node scripts/run-with-env.mjs node scripts/ensure-change-summary-report-fields.mjs --dry-run",
    "migrate:change-summary-report-fields": "node scripts/run-with-env.mjs node scripts/ensure-change-summary-report-fields.mjs --apply",
    "self-test:change-adjustment": "npm run build:server && node scripts/run-with-env.mjs node scripts/self-test-change-adjustment.mjs run",
    "self-test:change-adjustment:cleanup": "npm run build:server && node scripts/run-with-env.mjs node scripts/self-test-change-adjustment.mjs cleanup-only",
    "self-test:change-summary-report": "npm run build:server && node scripts/run-with-env.mjs node scripts/self-test-change-summary-report.mjs run",
    "self-test:change-summary-report:cleanup": "npm run build:server && node scripts/run-with-env.mjs node scripts/self-test-change-summary-report.mjs cleanup-only",
    "self-test:certificate-notifications": "npm run build:server && node scripts/run-with-env.mjs node scripts/self-test-certificate-notifications.mjs",
    "eslint": "eslint . --quiet",
    "stylelint": "stylelint client/src/**/*.css --quiet",
    "type:check": "concurrently -n \"server,client\" -c \"blue,green\" \"npm run type:check:server\" \"npm run type:check:client\"",
    "type:check:client": "tsc --noEmit --project tsconfig.app.json",
    "type:check:server": "tsc --noEmit --project tsconfig.node.json",
    "lint": "npm run eslint && npm run stylelint",
    "format": "prettier --write \"{server,client,test}/**/*.{js,ts,tsx,json,md}\"",
    "postinstall": "node scripts/postinstall.mjs"
  },
  "dependencies": {
    "@lark-apaas/fullstack-nestjs-core": "^1.1.0",
    "@larksuiteoapi/node-sdk": "1.73.0",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^10.4.20",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.20",
    "@nestjs/platform-express": "^10.4.20",
    "@nestjs/swagger": "^7.4.2",
    "@tanstack/react-form": "^1.27.6",
    "@tanstack/react-query": "^5.90.12",
    "axios": "^1.12.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "compression": "^1.8.1",
