  "overrides": {
    "dayjs": "^1.11.15"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@server/(.*)$": "<rootDir>/server/$1",
      "^@shared/(.*)$": "<rootDir>/shared/$1"
    },
    "testMatch": [
      "<rootDir>/server/**/*.spec.ts",
      "<rootDir>/test/unit/**/*.spec.ts"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/release/",
      "<rootDir>/output/"
    ]
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
